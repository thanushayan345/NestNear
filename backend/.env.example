# Copy this file to ".env" and change the values.
# NEVER commit your real .env file.

# Long random string used to sign session cookies.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite database file (relative paths are relative to the backend folder)
DATABASE_PATH=instance/nestnear.sqlite3

# Folder where uploaded photos are stored
UPLOAD_FOLDER=uploads

# Maximum request size in MB (photos are limited to 3 MB each)
MAX_UPLOAD_MB=5

# The address of the React dev server (used for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Set to true when the site is served over HTTPS
SESSION_COOKIE_SECURE=false

# Insert demo users and listings when the database is empty
SEED_SAMPLE_DATA=true

FLASK_DEBUG=true
PORT=5000
